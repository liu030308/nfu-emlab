---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { langPaths, nav, pageUrl, t, type Lang } from '../../i18n/ui';
import { lab, pi } from '../../data/lab';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = t(nav.find((n) => n.page === 'about')!.label, lang);
const L = {
  intro: { zh: '實驗室簡介', en: 'Introduction', ja: '研究室概要' },
  mission: { zh: '人才培育', en: 'Education', ja: '人材育成' },
  pi: { zh: '指導教授', en: 'Principal Investigator', ja: '指導教員' },
  edu: { zh: '學歷', en: 'Education', ja: '学歴' },
  exp: { zh: '專長', en: 'Expertise', ja: '専門分野' },
  contact: { zh: '聯絡方式', en: 'Contact', ja: '連絡先' },
  phoneLab: { zh: '研究室電話', en: 'Office Tel', ja: '研究室電話' },
  phoneOffice: { zh: '系辦電話', en: 'Dept. Office', ja: '学科事務室' },
  fax: { zh: '傳真', en: 'Fax', ja: 'FAX' },
  experience: { zh: '教學與服務經歷', en: 'Academic & Service Experience', ja: '教育・職務経歴' },
  courses: { zh: '開授課程方向', en: 'Courses Taught', ja: '担当科目分野' },
  patents: { zh: '代表專利成果', en: 'Selected Patents', ja: '主な特許実績' },
  officialPage: { zh: '虎科大電子系教師官方專頁', en: 'NFU Official Faculty Profile', ja: '虎尾科大 電子工学科 教員紹介ページ' },
};
---

<Base lang={lang} page="about" title={title}>
  <section class="page-hero">
    <div class="container">
      <h1>{title}</h1>
      <p>{t(lab.tagline, lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2 center">
      <div>
        <h2 class="section-title">{t(L.intro, lang)}</h2>
        <p>{t(lab.intro, lang)}</p>
        <p><span class="tag">📍 {t(lab.location, lang)}</span></p>
      </div>
      <figure class="lab-plaque-figure">
        <Img src={lab.labImage} alt={t(lab.name, lang)} lang={lang} ratio="4/3" label="Lab Plaque" />
        <figcaption class="plaque-caption">
          <strong>{t({ zh: '電子量測實驗室 實體門牌', en: 'Electronic Measurement Lab Official Plaque', ja: '電子計測研究室 公式木彫表札' }, lang)}</strong>
          <span>📍 {t(lab.location, lang)}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 class="section-title">{t(L.mission, lang)}</h2>
      <div class="steps">
        {
          lab.mission.map((m, i) => (
            <div class="card step">
              <span class="num">0{i + 1}</span>
              <h3>{t(m.title, lang)}</h3>
              <p>{t(m.desc, lang)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t({ zh: '實驗室環境與實體機台實景', en: 'Laboratory Facilities & Environment', ja: '研究室環境・実機設備' }, lang)}</h2>
      <p class="lead" style="margin-bottom: 2rem;">{t({ zh: '由歷屆學長姐與團隊夥伴共同維護的專業量測環境（ATC 0102）', en: 'Professional electronic measurement environment in ATC 0102', ja: '歴代の先輩方とメンバーで整備されたATC 0102の測定環境' }, lang)}</p>
      <div class="grid grid-3 lab-photos-grid">
        <div class="card photo-card">
          <Img src="/images/equipment/probe-station.webp" alt="半導體微探針量測平台" lang={lang} ratio="4/3" />
          <p class="photo-caption">🔬 <strong>{t({ zh: '半導體微探針量測平台', en: 'Micro-Probe Station', ja: 'マイクロプローブ計測' }, lang)}</strong></p>
        </div>
        <div class="card photo-card">
          <Img src="/images/equipment/daq.webp" alt="高速數位示波器" lang={lang} ratio="4/3" />
          <p class="photo-caption">📊 <strong>{t({ zh: '高速數位示波器 (BK 2565B)', en: 'Digital Storage Oscilloscope', ja: 'デジタルオシロスコープ' }, lang)}</strong></p>
        </div>
        <div class="card photo-card">
          <Img src="/images/equipment/rta.webp" alt="真空熱退火系統" lang={lang} ratio="4/3" />
          <p class="photo-caption">⚡ <strong>{t({ zh: '真空熱退火與精密溫控系統', en: 'Vacuum Annealing System', ja: '真空熱アニール装置' }, lang)}</strong></p>
        </div>
      </div>
      <div style="margin-top: 1.75rem; text-align: center;">
        <a class="btn btn-ghost" href={pageUrl(lang, 'facilities')}>{t({ zh: '查看全部實驗室機台與規範 →', en: 'View All Equipment & Facilities →', ja: '全設備・安全規則を見る →' }, lang)}</a>
      </div>
    </div>
  </section>

  <section class="section" id="pi">
    <div class="container">
      <h2 class="section-title">{t(L.pi, lang)}</h2>
      <div class="pi card">
        <div class="pi-photo">
          <Img src={pi.image} alt={t(pi.name, lang)} lang={lang} ratio="3/4" label={t(pi.name, lang)} />
        </div>
        <div>
          <h3 class="pi-name">{t(pi.name, lang)} <small>{lang === 'zh' ? 'Wen-Ray Chen' : ''}</small></h3>
          <p class="pi-title">{t(pi.title, lang)}</p>
          <dl>
            <dt>{t(L.edu, lang)}</dt>
            <dd>{t(pi.education, lang)}</dd>
            <dt>{t(L.exp, lang)}</dt>
            <dd class="tag-row">{pi.expertise.map((e) => <span class="tag">{t(e, lang)}</span>)}</dd>
            <dt>{t(L.experience, lang)}</dt>
            <dd>
              <ul class="pi-list">
                {pi.experience.map((item) => <li>{t(item, lang)}</li>)}
              </ul>
            </dd>
            <dt>{t(L.courses, lang)}</dt>
            <dd class="tag-row">{pi.courses.map((c) => <span class="tag">{t(c, lang)}</span>)}</dd>
            <dt>{t(L.patents, lang)}</dt>
            <dd>
              <ul class="pi-list">
                {pi.patents.map((p) => <li>{t(p, lang)}</li>)}
              </ul>
            </dd>
            <dt>{t(L.contact, lang)}</dt>
            <dd>
              📞 {t(L.phoneLab, lang)}：{pi.phoneLab}｜{t(L.phoneOffice, lang)}：{pi.phoneOffice}｜{t(L.fax, lang)}：{pi.fax}
              <br />✉️ <a href={`mailto:${pi.email}`}>{pi.email}</a>
              <br />🏢 {t(pi.office, lang)}
              <br />🌐 <a href={pi.profileUrl} target="_blank" rel="noopener noreferrer">{t(L.officialPage, lang)} ↗</a>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .center {
    align-items: center;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    counter-reset: s;
  }
  .num {
    font-family: Inter, sans-serif;
    font-weight: 800;
    font-size: 2rem;
    color: var(--cyan);
  }
  .step h3 {
    margin-top: 0.25rem;
  }
  .pi {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
  }
  @media (max-width: 680px) {
    .pi {
      grid-template-columns: 1fr;
    }
    .pi-photo {
      max-width: 240px;
    }
  }
  .pi-name {
    font-size: 1.7rem;
    margin: 0;
  }
  .pi-name small {
    font-size: 1rem;
    color: var(--muted);
    font-weight: 500;
  }
  .pi-title {
    color: var(--cyan);
    font-weight: 700;
    margin: 0.25rem 0 1rem;
  }
  dl {
    margin: 0;
  }
  dt {
    font-weight: 700;
    color: var(--heading);
    margin-top: 0.75rem;
  }
  dd {
    margin: 0.25rem 0 0;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }
  .pi-list {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
    color: var(--text);
    line-height: 1.75;
  }
  .pi-list li + li {
    margin-top: 0.15rem;
  }
  .lab-plaque-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .plaque-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
    color: var(--muted);
    padding: 0 0.25rem;
  }
  .plaque-caption strong {
    color: var(--heading);
    font-weight: 600;
  }
  .photo-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .photo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .photo-caption {
    margin: 0;
    font-size: 0.95rem;
    color: var(--heading);
    text-align: center;
  }
  .muted {
    color: var(--muted);
  }
</style>

