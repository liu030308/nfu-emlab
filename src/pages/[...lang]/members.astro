  <script is:inline>
    (() => {
      const openMemberModal = (id) => {
        const dlg = document.getElementById(`modal-${id}`);
        if (dlg instanceof HTMLDialogElement && typeof dlg.showModal === 'function') {
          dlg.showModal();
          document.body.style.overflow = 'hidden';
          if (history.replaceState) {
            history.replaceState(null, '', `#member-${id}`);
          }
        }
      };

      const closeMemberModal = (dlg) => {
        if (!dlg) return;
        dlg.close();
        document.body.style.overflow = '';
        if (location.hash.startsWith('#member-') && history.replaceState) {
          history.replaceState(null, '', location.pathname + location.search);
        }
      };

      document.querySelectorAll('[data-member-open]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-member-open');
          if (id) openMemberModal(id);
        });
      });

      document.querySelectorAll('dialog.member-modal').forEach((dlg) => {
        if (!(dlg instanceof HTMLDialogElement)) return;
        dlg.addEventListener('click', (e) => {
          const target = e.target;
          if (target === dlg || (target instanceof Element && target.closest('[data-member-close]'))) {
            closeMemberModal(dlg);
          }
        });
        dlg.addEventListener('close', () => {
          document.body.style.overflow = '';
        });
      });

      // 點擊複製電子郵件（Modern Clipboard API with fallback）
      document.querySelectorAll('.btn-copy-email').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const email = btn.getAttribute('data-copy-email');
          if (!email) return;

          const badge = btn.querySelector('.copy-badge');
          const origBadge = badge ? badge.textContent : '';

          const onCopied = () => {
            btn.classList.add('copied');
            if (badge) badge.textContent = '✓ 已複製！';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (badge) badge.textContent = origBadge;
            }, 2000);
          };

          try {
            if (navigator?.clipboard?.writeText) {
              await navigator.clipboard.writeText(email);
              onCopied();
            } else {
              const ta = document.createElement('textarea');
              ta.value = email;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              onCopied();
            }
          } catch (_) {}
        });
      });

      // 歷屆碩士生系所篩選、年份摺疊與關鍵字即時搜尋
      let activeDept = 'all';
      const searchInput = document.getElementById('grad-search');
      const yearGroups = document.querySelectorAll('.year-accordion');
      const deptTabs = document.querySelectorAll('[data-dept-filter]');
      const toggleAllBtn = document.getElementById('toggle-all-years');
      let allExpanded = false;

      const updateToggleBtnText = () => {
        if (!toggleAllBtn) return;
        const expTxt = toggleAllBtn.getAttribute('data-expand-text') ?? '展開全部年份';
        const colTxt = toggleAllBtn.getAttribute('data-collapse-text') ?? '收合全部年份';
        toggleAllBtn.textContent = allExpanded ? `▴ ${colTxt}` : `▾ ${expTxt}`;
      };

      const filterGradCards = () => {
        const q = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
        yearGroups.forEach((grp) => {
          if (!(grp instanceof HTMLDetailsElement)) return;
          const cards = grp.querySelectorAll('.grad-ms-card');
          let visibleCount = 0;
          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const d = card.getAttribute('data-dept');
            const s = card.getAttribute('data-search') ?? '';
            const matchDept = activeDept === 'all' || d === activeDept;
            const matchQuery = !q || s.includes(q);
            if (matchDept && matchQuery) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });
          grp.style.display = visibleCount > 0 ? '' : 'none';
          if (q && visibleCount > 0) {
            grp.open = true;
          } else if (!q && !allExpanded) {
            grp.open = grp.getAttribute('data-default-open') === '1';
          }
        });
      };

      deptTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          deptTabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          activeDept = tab.getAttribute('data-dept-filter') ?? 'all';
          filterGradCards();
        });
      });

      if (toggleAllBtn) {
        toggleAllBtn.addEventListener('click', () => {
          allExpanded = !allExpanded;
          yearGroups.forEach((grp) => {
            if (grp instanceof HTMLDetailsElement && grp.style.display !== 'none') {
              grp.open = allExpanded;
            }
          });
          updateToggleBtnText();
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterGradCards);
      }

      if (location.hash.startsWith('#member-')) {
        const initialId = location.hash.slice(8);
        if (initialId) openMemberModal(initialId);
      }
    })();
  </script>
</Base>

