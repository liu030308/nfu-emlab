---
import '../styles/global.css';
import { htmlLang, langList, languages, nav, pageUrl, absolutePageUrl, defaultLang, t, ui, withBase, type Lang } from '../i18n/ui';
import { lab, pi } from '../data/lab';
import { webmaster } from '../data/members';

interface Props {
  lang: Lang;
  page: string; // 目前頁面 slug，'' 為首頁
  title?: string;
  description?: string;
  is404?: boolean;
}
const { lang, page, title, description, is404 = false } = Astro.props;
const siteName = t(ui.siteName, lang);
const fullTitle = title ? `${title}｜${siteName}` : `${siteName}｜${t(ui.univ, lang)}`;
const desc = description ?? t(lab.tagline, lang);
const short: Record<Lang, string> = { zh: '中', en: 'EN', ja: '日' };
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const ogImageUrl = Astro.site ? new URL(withBase('/images/pi-chen.jpg'), Astro.site).toString() : withBase('/images/pi-chen.jpg');

// 針對 404 頁，語言切換連結應直接回各語系首頁，避免連往不存在的 /en/404/ 或 /ja/404/
const navUrlZh = is404 ? pageUrl('zh') : pageUrl('zh', page);
const navUrlEn = is404 ? pageUrl('en') : pageUrl('en', page);
const navUrlJa = is404 ? pageUrl('ja') : pageUrl('ja', page);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070d19" id="theme-color-meta" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico?v=6')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png?v=6')} id="dynamic-favicon" />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png?v=6')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48x48.png?v=6')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon.png?v=6')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png?v=6')} />
    {!is404 && langList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={absolutePageUrl(Astro.site, l, page)} />
    ))}
    {!is404 && (
      <link rel="alternate" hreflang="x-default" href={absolutePageUrl(Astro.site, defaultLang, page)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${siteName}｜${t(ui.univ, lang)}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
          document.documentElement.dataset.theme = theme;
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = theme;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <!-- 科技感背景光暈、晶圓座標網格與電路紋理層 -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-spotlight" id="bg-spotlight"></div>
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
      <div class="bg-orb bg-orb-3"></div>
      <svg class="bg-circuit bg-circuit-left" viewBox="0 0 320 640" fill="none">
        <path d="M0 80H90L130 120V240L170 280H260" stroke="currentColor" stroke-width="1.5" />
        <path d="M0 180H60L100 220V380L150 430H220" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 6" />
        <path d="M0 480H80L120 440H200L240 480V580" stroke="currentColor" stroke-width="1.5" />
        <circle cx="90" cy="80" r="4" fill="currentColor" />
        <circle cx="130" cy="240" r="4" fill="currentColor" />
        <circle cx="260" cy="280" r="5" stroke="currentColor" stroke-width="2" />
        <circle cx="100" cy="220" r="3.5" fill="currentColor" />
        <circle cx="220" cy="430" r="4.5" stroke="currentColor" stroke-width="2" />
        <circle cx="120" cy="440" r="3.5" fill="currentColor" />
        <circle cx="240" cy="580" r="4" fill="currentColor" />
      </svg>
      <svg class="bg-circuit bg-circuit-right" viewBox="0 0 360 640" fill="none">
        <circle cx="280" cy="220" r="110" stroke="currentColor" stroke-width="1" stroke-dasharray="3 8" />
        <circle cx="280" cy="220" r="165" stroke="currentColor" stroke-width="1" opacity="0.6" />
        <path d="M360 120H250L210 160H120" stroke="currentColor" stroke-width="1.5" />
        <path d="M360 340H260L210 390V510L160 560H80" stroke="currentColor" stroke-width="1.5" />
        <circle cx="120" cy="160" r="5" stroke="currentColor" stroke-width="2" />
        <circle cx="250" cy="120" r="3.5" fill="currentColor" />
        <circle cx="210" cy="390" r="4" fill="currentColor" />
        <circle cx="80" cy="560" r="5" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>


    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a class="brand" href={pageUrl(lang)}>
          <span class="brand-mark" aria-hidden="true">
            <picture>
              <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_navbar_static.webp')} type="image/webp" />
              <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_navbar_static.png')} type="image/png" />
              <source srcset={withBase('/images/logo_navbar_animated.webp')} type="image/webp" />
              <img
                src={withBase('/images/logo_navbar_animated.gif')}
                alt="NFU LED LAB Logo"
                width="44"
                height="44"
                class="brand-logo-img"
                loading="eager"
              />
            </picture>
          </span>
          <span class="brand-text">
            <strong>{siteName}</strong>
            <small>NFU · {lab.room}</small>
          </span>
        </a>

        <!-- 無障礙手機版選單按鈕（真實 button，支援鍵盤焦點與 Esc 關閉） -->
        <button
          type="button"
          id="nav-btn"
          class="nav-btn"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label={t(ui.navMenu, lang)}
        >
          <span class="nav-btn-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Main Navigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={pageUrl(lang, n.page)} aria-current={n.page === page ? 'page' : undefined}>
                    {t(n.label, lang)}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav-actions">
            <div
              class="lang-dropdown"
              id="lang-dropdown"
              data-current-lang={lang}
              data-url-zh={navUrlZh}
              data-url-en={navUrlEn}
              data-url-ja={navUrlJa}
            >
              <button
                type="button"
                class="lang-btn"
                id="lang-btn"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={t(ui.langMenuAria, lang)}
                title={t(ui.langMenuAria, lang)}
              >
                <svg class="lang-globe-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <span class="lang-current-text">{lang === 'zh' ? '繁中' : lang === 'en' ? 'EN' : '日本語'}</span>
                <svg class="lang-chevron-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <div class="lang-menu" id="lang-menu" role="menu" aria-label={t(ui.langMenuRole, lang)}>
                <div class="lang-menu-info">
                  <div class="lang-menu-info-title">
                    <span class="pulse-indicator"></span>
                    <span>{t(ui.langAutoTitle, lang)}</span>
                  </div>
                  <div class="lang-detected-display" id="lang-detected-text">{t(ui.langDetecting, lang)}</div>
                </div>

                <div class="lang-menu-divider"></div>

                <button type="button" class="lang-menu-item lang-switch-detected" id="lang-btn-switch-detected" role="menuitem">
                  <div class="lang-item-content">
                    <span class="lang-item-icon">⚡</span>
                    <div class="lang-item-labels">
                      <span class="lang-item-name">{t(ui.langSwitchToDetected, lang)}</span>
                      <small class="lang-item-desc" id="lang-detected-action-desc">{t(ui.langAutoDesc, lang)}</small>
                    </div>
                  </div>
                </button>

                <div class="lang-menu-divider"></div>

                <a href={navUrlZh} class:list={['lang-menu-item', { active: lang === 'zh' }]} data-lang="zh" role="menuitem">
                  <div class="lang-item-content">
                    <span class="lang-item-icon">🇹🇼</span>
                    <div class="lang-item-labels">
                      <span class="lang-item-name">繁體中文</span>
                      <small class="lang-item-desc">Traditional Chinese</small>
                    </div>
                  </div>
                  {lang === 'zh' && <span class="lang-item-check" aria-hidden="true">✓</span>}
                </a>

                <a href={navUrlEn} class:list={['lang-menu-item', { active: lang === 'en' }]} data-lang="en" role="menuitem">
                  <div class="lang-item-content">
                    <span class="lang-item-icon">🇺🇸</span>
                    <div class="lang-item-labels">
                      <span class="lang-item-name">English</span>
                      <small class="lang-item-desc">English</small>
                    </div>
                  </div>
                  {lang === 'en' && <span class="lang-item-check" aria-hidden="true">✓</span>}
                </a>

                <a href={navUrlJa} class:list={['lang-menu-item', { active: lang === 'ja' }]} data-lang="ja" role="menuitem">
                  <div class="lang-item-content">
                    <span class="lang-item-icon">🇯🇵</span>
                    <div class="lang-item-labels">
                      <span class="lang-item-name">日本語</span>
                      <small class="lang-item-desc">Japanese</small>
                    </div>
                  </div>
                  {lang === 'ja' && <span class="lang-item-check" aria-hidden="true">✓</span>}
                </a>
              </div>
            </div>
            <button
              type="button"
              class="theme-btn"
              id="theme-toggle"
              aria-label={t(ui.themeToggle, lang)}
              title={t(ui.themeToggle, lang)}
            >
              <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{t(lab.name, lang)}</strong>
          <p>{t(ui.univ, lang)}</p>
          <p>{t(lab.location, lang)}</p>
        </div>
        <div>
          <p>📞 {pi.phoneLab}</p>
          <p>✉️ <a href={`mailto:${pi.email}`} data-contact-email-trigger>{pi.email}</a></p>
          <p>{t(lab.address, lang)}</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {t(ui.footerRights, lang)}</span>
        <span>
          {t(ui.maintainer, lang)}：<a href="https://xn--bfry6vtzs.tw/" target="_blank" rel="noopener">{webmaster}</a>
        </span>
      </div>
    </footer>

    <!-- 全域智慧郵件聯絡彈窗 (Contact Email Dialog) -->
    <dialog id="contact-email-modal" class="contact-email-modal" aria-labelledby="contact-modal-title">
      <div class="contact-email-box">
        <button type="button" class="contact-email-close" id="contact-modal-close" aria-label={lang === 'zh' ? '關閉' : lang === 'en' ? 'Close' : '閉じる'}>✕</button>
        <div class="contact-email-header">
          <h2 id="contact-modal-title">
            <span aria-hidden="true">✉️</span>
            <span>{lang === 'zh' ? '聯絡實驗室・發送郵件' : lang === 'en' ? 'Contact Lab・Send Email' : '研究室へのお問い合わせ'}</span>
          </h2>
          <p>
            {lang === 'zh'
              ? '歡迎專題實作、產學合作、量測技術諮詢與參觀交流'
              : lang === 'en'
              ? 'Welcome research projects, industry collaboration, testing inquiries, and visits'
              : '学生配属・産学連携・受託計測・研究室見学のご相談'}
          </p>
        </div>

        <div class="contact-email-card">
          <div>
            <div style="font-size:0.75rem; color:var(--muted); margin-bottom:0.15rem;">
              {lang === 'zh' ? '指導教授電子郵件' : lang === 'en' ? 'Professor Email' : '指導教授メールアドレス'}
            </div>
            <span class="contact-email-address">{pi.email}</span>
          </div>
          <span class="contact-copy-badge" id="contact-badge-copied">
            ✓ {lang === 'zh' ? '已自動複製' : lang === 'en' ? 'Auto Copied' : 'コピー完了'}
          </span>
        </div>

        <div class="contact-action-list">
          <a
            class="contact-action-item primary"
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${pi.email}&su=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="contact-action-meta">
              <span>🌐 {lang === 'zh' ? '開啟 Gmail 網頁版發信' : lang === 'en' ? 'Open Gmail on the Web' : 'Gmail Web版で作成'}</span>
              <small>{lang === 'zh' ? '在新分頁開啟 Gmail 寫信介面' : lang === 'en' ? 'Opens compose window in new tab' : '新しいタブで作成画面を開く'}</small>
            </div>
            <span class="contact-action-arrow">↗</span>
          </a>

          <a
            class="contact-action-item"
            href={`mailto:${pi.email}?subject=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
          >
            <div class="contact-action-meta">
              <span>✉️ {lang === 'zh' ? '開啟預設郵件應用程式' : lang === 'en' ? 'Open Default Mail App' : '既定のメールアプリを開く'}</span>
              <small>{lang === 'zh' ? '啟動本機或手機內建 Outlook / Mail 應用程式' : lang === 'en' ? 'Launches system Mail / Outlook client' : 'PC・スマートフォンのメールアプリを起動'}</small>
            </div>
            <span class="contact-action-arrow">→</span>
          </a>

          <a
            class="contact-action-item"
            href={`https://outlook.office.com/mail/deeplink/compose?to=${pi.email}&subject=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="contact-action-meta">
              <span>🏢 {lang === 'zh' ? '開啟 Outlook 網頁版' : lang === 'en' ? 'Open Outlook Web' : 'Outlook Web版で作成'}</span>
              <small>{lang === 'zh' ? '適合學校與企業 Microsoft 365 帳號直接登入發信' : lang === 'en' ? 'Best for Microsoft 365 university / work accounts' : '大学や職場のMicrosoft 365アカウント用'}</small>
            </div>
            <span class="contact-action-arrow">↗</span>
          </a>

          <button type="button" class="contact-action-item" id="btn-copy-email-again">
            <div class="contact-action-meta">
              <span id="label-copy-again">📋 {lang === 'zh' ? '手動再次複製信箱地址' : lang === 'en' ? 'Copy Email Address Again' : 'メールアドレスを再コピー'}</span>
              <small>{lang === 'zh' ? '方便貼至任何通訊軟體或備忘錄' : lang === 'en' ? 'Paste into any app or messaging tool' : '他のアプリやメールソフトに貼り付け'}</small>
            </div>
            <span class="contact-action-arrow">📋</span>
          </button>
        </div>
      </div>
    </dialog>

    <!-- 全域懸浮 Toast 提示 -->
    <div id="contact-toast" class="contact-toast" role="status" aria-live="polite">
      <span>📋</span>
      <span id="contact-toast-text">{lang === 'zh' ? `已複製電子信箱：${pi.email}` : lang === 'en' ? `Email copied: ${pi.email}` : `メールアドレスをコピーしました: ${pi.email}`}</span>
    </div>

    <script is:inline define:vars={{ currentLang: lang, urlZh: navUrlZh, urlEn: navUrlEn, urlJa: navUrlJa }}>
      (() => {
        // 主題切換邏輯（同步更新 data-theme、meta[color-scheme]、theme-color 與 localStorage）
        const themeBtn = document.getElementById('theme-toggle');
        const syncTheme = (theme) => {
          const root = document.documentElement;
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = theme;
          const themeColor = document.getElementById('theme-color-meta');
          if (themeColor) themeColor.content = theme === 'dark' ? '#070d19' : '#f8fafc';
        };

        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const root = document.documentElement;
            const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            syncTheme(next);
            try {
              localStorage.setItem('theme', next);
            } catch (_) {}
          });
        }

        // 跨分頁同源同步主題變更
        window.addEventListener('storage', (e) => {
          if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
            syncTheme(e.newValue);
          }
        });

        // 手機版導覽選單（無障礙 Button，支援 Esc 關閉與點擊外部關閉）
        const navBtn = document.getElementById('nav-btn');
        const siteNav = document.getElementById('site-nav');
        const closeNav = () => {
          if (!siteNav) return;
          siteNav.classList.remove('open');
          document.body.classList.remove('nav-open');
          if (navBtn) {
            navBtn.classList.remove('open');
            navBtn.setAttribute('aria-expanded', 'false');
          }
        };

        if (navBtn && siteNav) {
          navBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = siteNav.classList.toggle('open');
            document.body.classList.toggle('nav-open', isOpen);
            navBtn.classList.toggle('open', isOpen);
            navBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          document.addEventListener('click', (e) => {
            const target = e.target;
            if (target instanceof Node && !siteNav.contains(target) && !navBtn.contains(target)) {
              closeNav();
            }
          });

          siteNav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeNav);
          });
        }

        // 語言選單與本機語言智慧切換邏輯
        const dropdown = document.getElementById('lang-dropdown');
        const btn = document.getElementById('lang-btn');
        const menu = document.getElementById('lang-menu');
        const detectedText = document.getElementById('lang-detected-text');
        const switchDetectedBtn = document.getElementById('lang-btn-switch-detected');
        const detectedActionDesc = document.getElementById('lang-detected-action-desc');

        const closeDropdown = () => {
          if (!dropdown) return;
          dropdown.classList.remove('open');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        };

        if (dropdown && btn && menu) {
          // 偵測訪客系統／瀏覽器偏好語言
          const navLangs = navigator.languages ?? [navigator.language ?? 'zh'];
          const detectedFull = navigator.language ?? 'zh-TW';
          let detected = 'zh';

          for (const raw of navLangs) {
            const l = (raw ?? '').toLowerCase();
            if (l.startsWith('ja')) { detected = 'ja'; break; }
            if (l.startsWith('en')) { detected = 'en'; break; }
            if (l.startsWith('zh')) { detected = 'zh'; break; }
          }

          const langNameMap = {
            zh: `繁體中文 (${detectedFull})`,
            en: `English (${detectedFull})`,
            ja: `日本語 (${detectedFull})`,
          };

          if (detectedText) {
            detectedText.textContent = langNameMap[detected] ?? detectedFull;
          }

          // 如果當前頁面與偵測到的瀏覽器語言相同，提示已是目前語言
          if (detectedActionDesc) {
            if (detected === currentLang) {
              detectedActionDesc.textContent =
                currentLang === 'zh'
                  ? '（已是目前頁面語言）'
                  : currentLang === 'en'
                    ? '(Current language)'
                    : '（現在の言語です）';
            } else {
              const prefix =
                currentLang === 'zh'
                  ? '點擊立即切換至 '
                  : currentLang === 'en'
                    ? 'Switch to '
                    : 'クリックして切り替え: ';
              const targetName =
                detected === 'zh' ? '繁體中文' : detected === 'en' ? 'English' : '日本語';
              detectedActionDesc.textContent = `${prefix}${targetName}`;
            }
          }

          // 切換選單開啟／關閉
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = dropdown.classList.toggle('open');
            btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          // 點擊選單外部自動收合
          document.addEventListener('click', (e) => {
            const target = e.target;
            if (target instanceof Node && !dropdown.contains(target)) {
              closeDropdown();
            }
          });

          // 點擊「使用瀏覽器偏好語言切換」
          if (switchDetectedBtn) {
            switchDetectedBtn.addEventListener('click', () => {
              closeDropdown();
              const urlMap = { zh: urlZh, en: urlEn, ja: urlJa };
              if (urlMap[detected] && detected !== currentLang) {
                window.location.href = urlMap[detected];
              }
            });
          }
        }

        // ==========================================
        // === 全域無障礙鍵盤 Esc 關閉優先層級 ===
        // ==========================================
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            // 優先關閉語言選單並回復語言按鈕焦點
            if (dropdown?.classList.contains('open')) {
              e.preventDefault();
              e.stopPropagation();
              closeDropdown();
              btn?.focus();
              return;
            }
            // 若語言選單未開，才關閉手機導覽列並回復漢堡按鈕焦點
            if (siteNav?.classList.contains('open')) {
              e.preventDefault();
              closeNav();
              navBtn?.focus();
            }
          }
        });

        // ==========================================
        // === 分頁圖示動畫（Tab Favicon Animation） ===
        // ==========================================
        (() => {
          try {
            const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
            if (prefersReduced) return;

            const favEl = document.getElementById('dynamic-favicon');
            if (!favEl || !(favEl instanceof HTMLLinkElement)) return;

            const totalFrames = 8;
            let frameIdx = 0;
            let frameTimer = null;

            // 預載分頁圖示幀以確保流暢切換
            const frameImgs = Array.from({ length: totalFrames }, (_, f) => {
              const img = new Image();
              img.src = `/images/tab_frames/frame_${f}.png`;
              return img;
            });

            const cycle = () => {
              if (document.hidden) return;
              frameIdx = (frameIdx + 1) % totalFrames;
              favEl.href = frameImgs[frameIdx].src;
            };

            frameTimer = setInterval(cycle, 180);

            document.addEventListener('visibilitychange', () => {
              if (document.hidden) {
                if (frameTimer) {
                  clearInterval(frameTimer);
                  frameTimer = null;
                }
              } else if (!frameTimer) {
                frameTimer = setInterval(cycle, 180);
              }
            });
          } catch (_) {}
        })();

        // ==========================================
        // === 科技感滑鼠互動體驗（Mouse Interactivity） ===
        // ==========================================
        const hasPointerFine = window.matchMedia?.('(pointer: fine)')?.matches;
        const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
        if (!hasPointerFine || prefersReducedMotion) return;

        // 1. 全域滑鼠聚光燈（支援靜止時暫停 requestAnimationFrame）
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight * 0.35;
        let targetX = mouseX;
        let targetY = mouseY;
        let isSpotlightRunning = false;

        const updateSpotlight = () => {
          const dx = targetX - mouseX;
          const dy = targetY - mouseY;
          if (Math.abs(dx) > 0.15 || Math.abs(dy) > 0.15) {
            mouseX += dx * 0.15;
            mouseY += dy * 0.15;
            document.documentElement.style.setProperty('--mouse-x', `${mouseX.toFixed(1)}px`);
            document.documentElement.style.setProperty('--mouse-y', `${mouseY.toFixed(1)}px`);
            requestAnimationFrame(updateSpotlight);
          } else {
            mouseX = targetX;
            mouseY = targetY;
            document.documentElement.style.setProperty('--mouse-x', `${mouseX.toFixed(1)}px`);
            document.documentElement.style.setProperty('--mouse-y', `${mouseY.toFixed(1)}px`);
            isSpotlightRunning = false;
          }
        };

        window.addEventListener(
          'mousemove',
          (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!isSpotlightRunning) {
              isSpotlightRunning = true;
              requestAnimationFrame(updateSpotlight);
            }
          },
          { passive: true }
        );

        // 2. 卡片 3D 視差傾斜與邊界流光（Card 3D Tilt & Magnetic Border Glow）
        const bindCards = () => {
          const cards = document.querySelectorAll('.card, .stat, .hero-logo-box, .advisor');
          cards.forEach((card) => {
            if (!(card instanceof HTMLElement) || card._hasTilt) return;
            card._hasTilt = true;

            card.addEventListener(
              'mousemove',
              (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--card-x', `${x.toFixed(1)}px`);
                card.style.setProperty('--card-y', `${y.toFixed(1)}px`);

                const cx = rect.width / 2;
                const cy = rect.height / 2;
                const rotX = ((y - cy) / cy) * -6;
                const rotY = ((x - cx) / cx) * 6;
                card.style.transform = `perspective(900px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateY(-4px)`;
              },
              { passive: true }
            );

            card.addEventListener('mouseleave', () => {
              card.style.transform = '';
              card.style.removeProperty('--card-x');
              card.style.removeProperty('--card-y');
            });
          });
        };
        bindCards();
        window.addEventListener('load', bindCards);

        // 3. 首頁 Hero 主視覺 Logo 滑鼠 3D 視差
        const hero = document.querySelector('.hero');
        const logoBox = document.querySelector('.hero-logo-box');
        const halo = document.querySelector('.hero-logo-halo');
        if (hero && logoBox && logoBox instanceof HTMLElement) {
          hero.addEventListener(
            'mousemove',
            (e) => {
              const rect = hero.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              const rotX = -(y / rect.height) * 12;
              const rotY = (x / rect.width) * 12;
              logoBox.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateZ(12px)`;
              if (halo && halo instanceof HTMLElement) {
                halo.style.transform = `translate(${(-x * 0.04).toFixed(1)}px, ${(-y * 0.04).toFixed(1)}px)`;
              }
            },
            { passive: true }
          );

          hero.addEventListener('mouseleave', () => {
            logoBox.style.transform = '';
            if (halo && halo instanceof HTMLElement) halo.style.transform = '';
          });
        }

        // 4. 按鈕微磁吸回饋（Magnetic Button Attraction）
        const btns = document.querySelectorAll('.btn, .theme-btn, .lang-btn');
        btns.forEach((b) => {
          if (!(b instanceof HTMLElement)) return;
          b.addEventListener(
            'mousemove',
            (e) => {
              const rect = b.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              b.style.transform = `translate(${(x * 0.2).toFixed(1)}px, ${(y * 0.2).toFixed(1)}px)`;
            },
            { passive: true }
          );
          b.addEventListener('mouseleave', () => {
            b.style.transform = '';
          });
        });

        // 5. 智慧郵件聯絡彈窗與自動複製邏輯
        const contactModal = document.getElementById('contact-email-modal');
        const contactCloseBtn = document.getElementById('contact-modal-close');
        const contactToast = document.getElementById('contact-toast');
        const copyAgainBtn = document.getElementById('btn-copy-email-again');
        const badgeCopied = document.getElementById('contact-badge-copied');
        const targetEmail = 'chenwr@nfu.edu.tw';

        const showToast = (text) => {
          if (!contactToast) return;
          if (text) {
            const span = document.getElementById('contact-toast-text');
            if (span) span.textContent = text;
          }
          contactToast.classList.add('show');
          clearTimeout(window.__contactToastTimer);
          window.__contactToastTimer = setTimeout(() => {
            contactToast.classList.remove('show');
          }, 2600);
        };

        const copyEmailToClipboard = async () => {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(targetEmail);
            } else {
              const ta = document.createElement('textarea');
              ta.value = targetEmail;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.focus();
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            showToast();
            if (badgeCopied) {
              badgeCopied.style.display = 'inline-flex';
            }
          } catch (_) {}
        };

        const openContactModal = () => {
          if (contactModal instanceof HTMLDialogElement) {
            if (typeof contactModal.showModal === 'function') {
              contactModal.showModal();
            } else {
              contactModal.setAttribute('open', '');
            }
            copyEmailToClipboard();
          }
        };

        const closeContactModal = () => {
          if (contactModal instanceof HTMLDialogElement) {
            if (typeof contactModal.close === 'function') {
              contactModal.close();
            } else {
              contactModal.removeAttribute('open');
            }
          }
        };

        if (contactCloseBtn) {
          contactCloseBtn.addEventListener('click', closeContactModal);
        }
        if (contactModal) {
          contactModal.addEventListener('click', (e) => {
            if (e.target === contactModal) closeContactModal();
          });
        }
        if (copyAgainBtn) {
          copyAgainBtn.addEventListener('click', () => {
            copyEmailToClipboard();
            const lbl = document.getElementById('label-copy-again');
            if (lbl) {
              const orig = lbl.textContent;
              lbl.textContent = '✓ 已成功複製！';
              setTimeout(() => { lbl.textContent = orig; }, 2000);
            }
          });
        }

        // 攔截點擊「寄信給我們」、所有 mailto 連結或含有 data-contact-email-trigger 的元素
        document.addEventListener('click', (e) => {
          const trigger = e.target instanceof Element ? e.target.closest('[data-contact-email-trigger], a[href^="mailto:"]') : null;
          if (!trigger) return;
          // 若在彈窗內部點擊 mailto，放行瀏覽器原生處理
          if (trigger.closest('#contact-email-modal')) return;
          e.preventDefault();
          openContactModal();
        });
      })();
    </script>
  </body>
</html>
