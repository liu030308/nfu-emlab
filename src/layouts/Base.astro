---
import '../styles/global.css';
import { htmlLang, langList, languages, nav, pageUrl, absolutePageUrl, defaultLang, t, ui, withBase, type Lang } from '../i18n/ui';
import { lab, pi } from '../data/lab';
import { webmaster } from '../data/members';

interface Props {
  lang: Lang;
  page: string; // 目前頁面 slug，'' 為首頁
  title?: string;
  description?: string;
  is404?: boolean;
}
const { lang, page, title, description, is404 = false } = Astro.props;
const siteName = t(ui.siteName, lang);
const fullTitle = title ? `${title}｜${siteName}` : `${siteName}｜${t(ui.univ, lang)}`;
const desc = description ?? t(lab.tagline, lang);
const short: Record<Lang, string> = { zh: '中', en: 'EN', ja: '日' };
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const ogImageUrl = Astro.site ? new URL(withBase('/images/pi-chen.jpg'), Astro.site).toString() : withBase('/images/pi-chen.jpg');

// 針對 404 頁，語言切換連結應直接回各語系首頁，避免連往不存在的 /en/404/ 或 /ja/404/
const navUrlZh = is404 ? pageUrl('zh') : pageUrl('zh', page);
const navUrlEn = is404 ? pageUrl('en') : pageUrl('en', page);
const navUrlJa = is404 ? pageUrl('ja') : pageUrl('ja', page);

// 依當前頁面語系按需載入對應字型（避免中文站額外下載日文字型、英文站多下載 CJK 字型）
const fontUrl =
  lang === 'zh'
    ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap'
    : lang === 'ja'
      ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap'
      : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap';
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070d19" id="theme-color-meta" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico?v=6')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png?v=6')} id="dynamic-favicon" />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png?v=6')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48x48.png?v=6')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon.png?v=6')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png?v=6')} />
    {!is404 && langList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={absolutePageUrl(Astro.site, l, page)} />
    ))}
    {!is404 && (
      <link rel="alternate" hreflang="x-default" href={absolutePageUrl(Astro.site, defaultLang, page)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${siteName}｜${t(ui.univ, lang)}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontUrl} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={fontUrl} /></noscript>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
          document.documentElement.dataset.theme = theme;
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = theme;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <!-- 科技感背景光暈、晶圓座標網格與電路紋理層 -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-spotlight" id="bg-spotlight"></div>
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
      <div class="bg-orb bg-orb-3"></div>
      <svg class="bg-circuit bg-circuit-left" viewBox="0 0 320 640" fill="none">
        <path d="M0 80H90L130 120V240L170 280H260" stroke="currentColor" stroke-width="1.5" />
        <path d="M0 180H60L100 220V380L150 430H220" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 6" />
        <path d="M0 480H80L120 440H200L240 480V580" stroke="currentColor" stroke-width="1.5" />
        <circle cx="90" cy="80" r="4" fill="currentColor" />
        <circle cx="130" cy="240" r="4" fill="currentColor" />
        <circle cx="260" cy="280" r="5" stroke="currentColor" stroke-width="2" />
        <circle cx="100" cy="220" r="3.5" fill="currentColor" />
        <circle cx="220" cy="430" r="4.5" stroke="currentColor" stroke-width="2" />
        <circle cx="120" cy="440" r="3.5" fill="currentColor" />
        <circle cx="240" cy="580" r="4" fill="currentColor" />
      </svg>
      <svg class="bg-circuit bg-circuit-right" viewBox="0 0 360 640" fill="none">
        <circle cx="280" cy="220" r="110" stroke="currentColor" stroke-width="1" stroke-dasharray="3 8" />
        <circle cx="280" cy="220" r="165" stroke="currentColor" stroke-width="1" opacity="0.6" />
        <path d="M360 120H250L210 160H120" stroke="currentColor" stroke-width="1.5" />
        <path d="M360 340H260L210 390V510L160 560H80" stroke="currentColor" stroke-width="1.5" />
        <circle cx="120" cy="160" r="5" stroke="currentColor" stroke-width="2" />
        <circle cx="250" cy="120" r="3.5" fill="currentColor" />
        <circle cx="210" cy="390" r="4" fill="currentColor" />
        <circle cx="80" cy="560" r="5" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>


    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a class="brand" href={pageUrl(lang)}>
          <span class="brand-mark" aria-hidden="true">
            <picture>
              <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_navbar_static.webp')} type="image/webp" />
              <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_navbar_static.png')} type="image/png" />
              <source srcset={withBase('/images/logo_navbar_animated.webp')} type="image/webp" />
              <img
                src={withBase('/images/logo_navbar_animated.gif')}
                alt="NFU LED LAB Logo"
                width="44"
                height="44"
                class="brand-logo-img"
                loading="eager"
              />
            </picture>
          </span>
          <span class="brand-text">
            <strong>{siteName}</strong>
            <small>NFU · {lab.room}</small>
          </span>
        </a>

        <!-- 無障礙手機版選單按鈕（真實 button，支援鍵盤焦點與 Esc 關閉） -->
        <button
          type="button"
          id="nav-btn"
          class="nav-btn"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label={t(ui.navMenu, lang)}
        >
          <span class="nav-btn-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Main Navigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={pageUrl(lang, n.page)} aria-current={n.page === page ? 'page' : undefined}>
                    {t(n.label, lang)}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav-actions">
            <div
              class="lang-dropdown"
              id="lang-dropdown"
              data-current-lang={lang}
              data-url-zh={navUrlZh}
              data-url-en={navUrlEn}
              data-url-ja={navUrlJa}
              data-tab-frame-prefix={withBase('/images/tab_frames/frame_')}
            >
              <button
                type="button"
                class="lang-btn"
                id="lang-btn"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={t(ui.langMenuAria, lang)}
                title={t(ui.langMenuAria, lang)}
              >
                <svg class="lang-globe-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </button>

              <div class="lang-menu notranslate" id="lang-menu" role="menu" aria-label={t(ui.langMenuRole, lang)} translate="no">
                <div class="lang-mode-tabs" role="tablist" aria-label={t(ui.langMenuRole, lang)}>
                  <button type="button" class="lang-mode-tab active" id="lang-tab-auto" data-mode="auto" role="tab" aria-selected="true">
                    <span aria-hidden="true">🌐</span>
                    <span>{t(ui.langModeAuto, lang)}</span>
                  </button>
                  <button type="button" class="lang-mode-tab" id="lang-tab-manual" data-mode="manual" role="tab" aria-selected="false">
                    <span aria-hidden="true">🌍</span>
                    <span>{t(ui.langModeManual, lang)}</span>
                  </button>
                </div>

                <div class="lang-panel" id="lang-panel-auto" role="tabpanel">
                  <div class="lang-menu-info">
                    <div class="lang-menu-info-title">
                      <span class="pulse-indicator"></span>
                      <span>{t(ui.langAutoTitle, lang)}</span>
                    </div>
                    <div class="lang-detected-display" id="lang-detected-text">{t(ui.langDetecting, lang)}</div>
                    <small class="lang-panel-hint">{t(ui.langAutoHint, lang)}</small>
                  </div>

                  <div class="lang-menu-divider"></div>

                  <button type="button" class="lang-menu-item lang-switch-detected" id="lang-btn-switch-detected" role="menuitem">
                    <div class="lang-item-content">
                      <span class="lang-item-icon" aria-hidden="true">⚡</span>
                      <div class="lang-item-labels">
                        <span class="lang-item-name">{t(ui.langSwitchToDetected, lang)}</span>
                        <small class="lang-item-desc" id="lang-detected-action-desc">{t(ui.langAutoDesc, lang)}</small>
                      </div>
                    </div>
                  </button>
                </div>

                <div class="lang-panel" id="lang-panel-manual" role="tabpanel" hidden>
                  <div class="lang-manual-header">{t(ui.langManualHint, lang)}</div>
                  <div class="lang-search-wrap">
                    <input
                      type="search"
                      id="lang-search-input"
                      class="lang-search-input"
                      placeholder={t(ui.langSearchPh, lang)}
                      autocomplete="off"
                      aria-label={t(ui.langSearchPh, lang)}
                    />
                  </div>
                  <div class="lang-manual-list" id="lang-manual-list"></div>
                  <div class="lang-no-match" id="lang-no-match" hidden>{t(ui.langNoMatch, lang)}</div>
                </div>

                <div id="google_translate_element" style="display:none" aria-hidden="true"></div>
              </div>
            </div>
            <button
              type="button"
              class="theme-btn"
              id="theme-toggle"
              aria-label={t(ui.themeToggle, lang)}
              title={t(ui.themeToggle, lang)}
            >
              <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{t(lab.name, lang)}</strong>
          <p>{t(ui.univ, lang)}</p>
          <p>{t(lab.location, lang)}</p>
        </div>
        <div>
          <p>📞 {pi.phoneLab}</p>
          <p>✉️ <a href={`mailto:${pi.email}`} data-contact-email-trigger>{pi.email}</a></p>
          <p>{t(lab.address, lang)}</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {t(ui.footerRights, lang)}</span>
        <span>
          {t(ui.maintainer, lang)}：<a href="https://xn--bfry6vtzs.tw/" target="_blank" rel="noopener">{webmaster}</a>
        </span>
      </div>
    </footer>

    <!-- 全域智慧郵件聯絡彈窗 (Contact Email Dialog) -->
    <dialog id="contact-email-modal" class="contact-email-modal" aria-labelledby="contact-modal-title">
      <div class="contact-email-box">
        <button type="button" class="contact-email-close" id="contact-modal-close" aria-label={lang === 'zh' ? '關閉' : lang === 'en' ? 'Close' : '閉じる'}>✕</button>
        <div class="contact-email-header">
          <h2 id="contact-modal-title">
            <span aria-hidden="true">✉️</span>
            <span>{lang === 'zh' ? '聯絡實驗室・發送郵件' : lang === 'en' ? 'Contact Lab・Send Email' : '研究室へのお問い合わせ'}</span>
          </h2>
          <p>
            {lang === 'zh'
              ? '歡迎專題實作、產學合作、量測技術諮詢與參觀交流'
              : lang === 'en'
              ? 'Welcome research projects, industry collaboration, testing inquiries, and visits'
              : '学生配属・産学連携・受託計測・研究室見学のご相談'}
          </p>
        </div>

        <div class="contact-email-card">
          <div>
            <div style="font-size:0.75rem; color:var(--muted); margin-bottom:0.15rem;">
              {lang === 'zh' ? '指導教授電子郵件' : lang === 'en' ? 'Professor Email' : '指導教授メールアドレス'}
            </div>
            <span class="contact-email-address">{pi.email}</span>
          </div>
          <span class="contact-copy-badge" id="contact-badge-copied">
            ✓ {lang === 'zh' ? '已自動複製' : lang === 'en' ? 'Auto Copied' : 'コピー完了'}
          </span>
        </div>

        <div class="contact-action-list">
          <a
            class="contact-action-item primary"
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${pi.email}&su=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="contact-action-meta">
              <span>🌐 {lang === 'zh' ? '開啟 Gmail 網頁版發信' : lang === 'en' ? 'Open Gmail on the Web' : 'Gmail Web版で作成'}</span>
              <small>{lang === 'zh' ? '在新分頁開啟 Gmail 寫信介面' : lang === 'en' ? 'Opens compose window in new tab' : '新しいタブで作成画面を開く'}</small>
            </div>
            <span class="contact-action-arrow">↗</span>
          </a>

          <a
            class="contact-action-item"
            href={`mailto:${pi.email}?subject=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
          >
            <div class="contact-action-meta">
              <span>✉️ {lang === 'zh' ? '開啟預設郵件應用程式' : lang === 'en' ? 'Open Default Mail App' : '既定のメールアプリを開く'}</span>
              <small>{lang === 'zh' ? '啟動本機或手機內建 Outlook / Mail 應用程式' : lang === 'en' ? 'Launches system Mail / Outlook client' : 'PC・スマートフォンのメールアプリを起動'}</small>
            </div>
            <span class="contact-action-arrow">→</span>
          </a>

          <a
            class="contact-action-item"
            href={`https://outlook.office.com/mail/deeplink/compose?to=${pi.email}&subject=${encodeURIComponent('【LED_LAB】諮詢與合作洽談')}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="contact-action-meta">
              <span>🏢 {lang === 'zh' ? '開啟 Outlook 網頁版' : lang === 'en' ? 'Open Outlook Web' : 'Outlook Web版で作成'}</span>
              <small>{lang === 'zh' ? '適合學校與企業 Microsoft 365 帳號直接登入發信' : lang === 'en' ? 'Best for Microsoft 365 university / work accounts' : '大学や職場のMicrosoft 365アカウント用'}</small>
            </div>
            <span class="contact-action-arrow">↗</span>
          </a>

          <button type="button" class="contact-action-item" id="btn-copy-email-again">
            <div class="contact-action-meta">
              <span id="label-copy-again">📋 {lang === 'zh' ? '手動再次複製信箱地址' : lang === 'en' ? 'Copy Email Address Again' : 'メールアドレスを再コピー'}</span>
              <small>{lang === 'zh' ? '方便貼至任何通訊軟體或備忘錄' : lang === 'en' ? 'Paste into any app or messaging tool' : '他のアプリやメールソフトに貼り付け'}</small>
            </div>
            <span class="contact-action-arrow">📋</span>
          </button>
        </div>
      </div>
    </dialog>

    <!-- 全站通用卡片詳細資訊彈窗 (Universal Card Detail Modal) -->
    <dialog id="u-card-modal" class="u-card-modal" aria-labelledby="u-modal-title">
      <div class="u-modal-box">
        <button type="button" class="u-modal-close" id="u-modal-close" aria-label={t(ui.closeModal, lang)}>✕</button>
        <div class="u-modal-media" id="u-modal-media" hidden>
          <img id="u-modal-img" src="" alt="" decoding="async" />
        </div>
        <div class="u-modal-header">
          <div class="u-modal-icon" id="u-modal-icon" hidden aria-hidden="true"></div>
          <div class="u-modal-heading">
            <div class="u-modal-badge-row" id="u-modal-badge-row"></div>
            <h2 id="u-modal-title"></h2>
            <p class="u-modal-subtitle" id="u-modal-subtitle" hidden></p>
          </div>
        </div>
        <blockquote class="u-modal-quote" id="u-modal-quote" hidden></blockquote>
        <p class="u-modal-desc" id="u-modal-desc" hidden></p>
        <div id="u-modal-sections"></div>
        <div id="u-modal-actions-wrap" class="u-modal-section" hidden>
          <div class="u-modal-actions" id="u-modal-actions"></div>
        </div>
      </div>
    </dialog>

    <!-- 全域懸浮 Toast 提示 -->
    <div id="contact-toast" class="contact-toast" role="status" aria-live="polite">
      <span>📋</span>
      <span id="contact-toast-text">{lang === 'zh' ? `已複製電子信箱：${pi.email}` : lang === 'en' ? `Email copied: ${pi.email}` : `メールアドレスをコピーしました: ${pi.email}`}</span>
    </div>

    <script>
      (() => {
        const win = window as unknown as {
          __contactToastTimer?: ReturnType<typeof setTimeout>;
          googleTranslateElementInit?: () => void;
          google?: {
            translate?: {
              TranslateElement?: new (opts: Record<string, unknown>, id: string) => unknown;
            };
          };
        };

        const dropdown = document.getElementById('lang-dropdown');
        const currentLang = (dropdown?.dataset.currentLang || 'zh') as 'zh' | 'en' | 'ja';
        const urlZh = dropdown?.dataset.urlZh || '/';
        const urlEn = dropdown?.dataset.urlEn || '/en/';
        const urlJa = dropdown?.dataset.urlJa || '/ja/';
        const tabFramePrefix = dropdown?.dataset.tabFramePrefix || '/images/tab_frames/frame_';

        // 主題切換邏輯（同步更新 data-theme、meta[color-scheme]、theme-color 與 localStorage）
        const themeBtn = document.getElementById('theme-toggle');
        const syncTheme = (theme: string) => {
          const root = document.documentElement;
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta instanceof HTMLMetaElement) meta.content = theme;
          const themeColor = document.getElementById('theme-color-meta');
          if (themeColor instanceof HTMLMetaElement) {
            themeColor.content = theme === 'dark' ? '#070d19' : '#f8fafc';
          }
        };

        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const root = document.documentElement;
            const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            syncTheme(next);
            try {
              localStorage.setItem('theme', next);
            } catch (_) {}
          });
        }

        // 跨分頁同源同步主題變更
        window.addEventListener('storage', (e) => {
          if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
            syncTheme(e.newValue);
          }
        });

        // 手機版導覽選單（無障礙 Button，支援 Esc 關閉與點擊外部關閉）
        const navBtn = document.getElementById('nav-btn');
        const siteNav = document.getElementById('site-nav');
        const closeNav = () => {
          if (!siteNav) return;
          siteNav.classList.remove('open');
          document.body.classList.remove('nav-open');
          if (navBtn) {
            navBtn.classList.remove('open');
            navBtn.setAttribute('aria-expanded', 'false');
          }
        };

        if (navBtn && siteNav) {
          navBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = siteNav.classList.toggle('open');
            document.body.classList.toggle('nav-open', isOpen);
            navBtn.classList.toggle('open', isOpen);
            navBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          document.addEventListener('click', (e) => {
            const target = e.target;
            if (target instanceof Node && !siteNav.contains(target) && !navBtn.contains(target)) {
              closeNav();
            }
          });

          siteNav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeNav);
          });
        }

        // 語言選單（自動 / 手動模式 + 萬國語言支援）
        const btn = document.getElementById('lang-btn');
        const menu = document.getElementById('lang-menu');
        const tabAuto = document.getElementById('lang-tab-auto');
        const tabManual = document.getElementById('lang-tab-manual');
        const panelAuto = document.getElementById('lang-panel-auto');
        const panelManual = document.getElementById('lang-panel-manual');
        const detectedText = document.getElementById('lang-detected-text');
        const switchDetectedBtn = document.getElementById('lang-btn-switch-detected');
        const detectedActionDesc = document.getElementById('lang-detected-action-desc');
        const searchInput = document.getElementById('lang-search-input');
        const manualListEl = document.getElementById('lang-manual-list');
        const noMatchEl = document.getElementById('lang-no-match');

        const MODE_KEY = 'nfu_lang_mode';
        const CODE_KEY = 'nfu_lang_code';
        const pageSourceLang = currentLang === 'zh' ? 'zh-TW' : currentLang;

        type WorldLang = {
          code: string;
          nativeCode?: 'zh' | 'en' | 'ja';
          name: string;
          enName: string;
          flag: string;
          native?: boolean;
          kw?: string;
        };

        const WORLD_LANGS: WorldLang[] = [
          { code: 'zh-TW', nativeCode: 'zh', name: '繁體中文', enName: 'Traditional Chinese', flag: '🇹🇼', native: true, kw: '繁中 正體 台灣' },
          { code: 'en', nativeCode: 'en', name: 'English', enName: 'English', flag: '🇺🇸', native: true, kw: '英文 英語 美國' },
          { code: 'ja', nativeCode: 'ja', name: '日本語', enName: 'Japanese', flag: '🇯🇵', native: true, kw: '日文 日語 日本' },
          { code: 'zh-CN', name: '简体中文', enName: 'Chinese Simplified', flag: '🇨🇳', kw: '簡體 簡中 中國' },
          { code: 'ko', name: '한국어', enName: 'Korean', flag: '🇰🇷', kw: '韓文 韓語 韓國' },
          { code: 'vi', name: 'Tiếng Việt', enName: 'Vietnamese', flag: '🇻🇳', kw: '越南文 越南語' },
          { code: 'th', name: 'ภาษาไทย', enName: 'Thai', flag: '🇹🇭', kw: '泰文 泰語 泰國' },
          { code: 'id', name: 'Bahasa Indonesia', enName: 'Indonesian', flag: '🇮🇩', kw: '印尼文 印尼語' },
          { code: 'ms', name: 'Bahasa Melayu', enName: 'Malay', flag: '🇲🇾', kw: '馬來文 馬來語' },
          { code: 'tl', name: 'Filipino', enName: 'Filipino / Tagalog', flag: '🇵🇭', kw: '菲律賓文 他加祿語' },
          { code: 'es', name: 'Español', enName: 'Spanish', flag: '🇪🇸', kw: '西班牙文 西語' },
          { code: 'fr', name: 'Français', enName: 'French', flag: '🇫🇷', kw: '法文 法語 法國' },
          { code: 'de', name: 'Deutsch', enName: 'German', flag: '🇩🇪', kw: '德文 德語 德國' },
          { code: 'it', name: 'Italiano', enName: 'Italian', flag: '🇮🇹', kw: '義大利文 義語' },
          { code: 'pt', name: 'Português', enName: 'Portuguese', flag: '🇵🇹', kw: '葡萄牙文 葡語' },
          { code: 'nl', name: 'Nederlands', enName: 'Dutch', flag: '🇳🇱', kw: '荷蘭文 荷蘭語' },
          { code: 'pl', name: 'Polski', enName: 'Polish', flag: '🇵🇱', kw: '波蘭文 波蘭語' },
          { code: 'ru', name: 'Русский', enName: 'Russian', flag: '🇷🇺', kw: '俄文 俄語 俄羅斯' },
          { code: 'uk', name: 'Українська', enName: 'Ukrainian', flag: '🇺🇦', kw: '烏克蘭文 烏克蘭語' },
          { code: 'cs', name: 'Čeština', enName: 'Czech', flag: '🇨🇿', kw: '捷克文 捷克語' },
          { code: 'sv', name: 'Svenska', enName: 'Swedish', flag: '🇸🇪', kw: '瑞典文 瑞典語' },
          { code: 'da', name: 'Dansk', enName: 'Danish', flag: '🇩🇰', kw: '丹麥文 丹麥語' },
          { code: 'fi', name: 'Suomi', enName: 'Finnish', flag: '🇫🇮', kw: '芬蘭文 芬蘭語' },
          { code: 'no', name: 'Norsk', enName: 'Norwegian', flag: '🇳🇴', kw: '挪威文 挪威語' },
          { code: 'el', name: 'Ελληνικά', enName: 'Greek', flag: '🇬🇷', kw: '希臘文 希臘語' },
          { code: 'hu', name: 'Magyar', enName: 'Hungarian', flag: '🇭🇺', kw: '匈牙利文 匈牙利語' },
          { code: 'ro', name: 'Română', enName: 'Romanian', flag: '🇷🇴', kw: '羅馬尼亞文' },
          { code: 'tr', name: 'Türkçe', enName: 'Turkish', flag: '🇹🇷', kw: '土耳其文 土耳其語' },
          { code: 'ar', name: 'العربية', enName: 'Arabic', flag: '🇸🇦', kw: '阿拉伯文 阿語' },
          { code: 'he', name: 'עברית', enName: 'Hebrew', flag: '🇮🇱', kw: '希伯來文' },
          { code: 'fa', name: 'فارسی', enName: 'Persian', flag: '🇮🇷', kw: '波斯文' },
          { code: 'hi', name: 'हिन्दी', enName: 'Hindi', flag: '🇮🇳', kw: '印地文 印度語' },
          { code: 'bn', name: 'বাংলা', enName: 'Bengali', flag: '🇧🇩', kw: '孟加拉文' },
          { code: 'ur', name: 'اردو', enName: 'Urdu', flag: '🇵🇰', kw: '烏爾都文' },
        ];

        const closeDropdown = () => {
          if (!dropdown) return;
          dropdown.classList.remove('open');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        };

        const getGoogTransTarget = () => {
          const m = document.cookie.match(/(?:^|;\s*)googtrans=([^;]+)/);
          if (!m) return '';
          const parts = decodeURIComponent(m[1]).split('/');
          return parts[2] || '';
        };

        const setGoogTransCookie = (targetCode: string) => {
          document.cookie = `googtrans=/${pageSourceLang}/${targetCode}; path=/`;
        };

        const clearGoogTransCookie = () => {
          const host = location.hostname;
          const domains = ['', host, `.${host}`];
          domains.forEach((d) => {
            const dPart = d ? `; domain=${d}` : '';
            document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${dPart}`;
          });
        };

        const detectBrowserLang = (): WorldLang => {
          const navLangs = navigator.languages?.length ? navigator.languages : [navigator.language || 'zh-TW'];
          for (const raw of navLangs) {
            const lower = (raw || '').toLowerCase();
            if (!lower) continue;
            if (lower === 'zh-cn' || lower === 'zh-sg' || lower.startsWith('zh-hans')) {
              return WORLD_LANGS.find((l) => l.code === 'zh-CN') || WORLD_LANGS[0];
            }
            if (lower === 'zh-tw' || lower === 'zh-hk' || lower === 'zh-mo' || lower.startsWith('zh-hant') || lower === 'zh') {
              return WORLD_LANGS[0];
            }
            if (lower.startsWith('fil') || lower.startsWith('tl')) {
              return WORLD_LANGS.find((l) => l.code === 'tl') || WORLD_LANGS[0];
            }
            if (lower.startsWith('iw') || lower.startsWith('he')) {
              return WORLD_LANGS.find((l) => l.code === 'he') || WORLD_LANGS[0];
            }
            if (lower.startsWith('nb') || lower.startsWith('nn') || lower.startsWith('no')) {
              return WORLD_LANGS.find((l) => l.code === 'no') || WORLD_LANGS[0];
            }
            const base = lower.split('-')[0];
            const found = WORLD_LANGS.find((l) => l.code.toLowerCase() === lower || l.code.toLowerCase() === base);
            if (found) return found;
          }
          return WORLD_LANGS[0];
        };

        let pendingGtCode = '';
        const triggerGtCombo = (targetCode: string) => {
          pendingGtCode = targetCode;
          let tries = 0;
          const poll = setInterval(() => {
            const combo = document.querySelector('#google_translate_element select.goog-te-combo');
            if (combo instanceof HTMLSelectElement && combo.options.length > 0) {
              clearInterval(poll);
              if (combo.value !== targetCode) {
                combo.value = targetCode;
                combo.dispatchEvent(new Event('change'));
              }
            } else if (++tries > 40) {
              clearInterval(poll);
            }
          }, 120);
        };

        const ensureGoogleTranslate = (targetCode: string) => {
          setGoogTransCookie(targetCode);
          const existingCombo = document.querySelector('#google_translate_element select.goog-te-combo');
          if (existingCombo instanceof HTMLSelectElement) {
            existingCombo.value = targetCode;
            existingCombo.dispatchEvent(new Event('change'));
            return;
          }
          win.googleTranslateElementInit = () => {
            const Ctor = win.google?.translate?.TranslateElement;
            if (Ctor) {
              new Ctor({ pageLanguage: pageSourceLang, autoDisplay: false }, 'google_translate_element');
              if (pendingGtCode) triggerGtCombo(pendingGtCode);
            }
          };
          pendingGtCode = targetCode;
          if (!document.getElementById('gt-element-script')) {
            const s = document.createElement('script');
            s.id = 'gt-element-script';
            s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
            s.async = true;
            document.head.appendChild(s);
          }
          triggerGtCombo(targetCode);
        };

        if (dropdown && btn && menu) {
          const detectedFull = navigator.language || 'zh-TW';
          const detectedLang = detectBrowserLang();
          const normPath = (s: string) => s.replace(/\/+$/, '') || '/';

          let currentMode: 'auto' | 'manual' = 'auto';
          let activeCode = pageSourceLang;
          try {
            if (localStorage.getItem(MODE_KEY) === 'manual') currentMode = 'manual';
            const storedCode = localStorage.getItem(CODE_KEY);
            if (currentMode === 'manual' && storedCode && WORLD_LANGS.some((l) => l.code === storedCode)) {
              const storedObj = WORLD_LANGS.find((l) => l.code === storedCode);
              activeCode = storedObj?.native ? pageSourceLang : storedCode;
            }
          } catch (_) {}

          if (detectedText) {
            detectedText.textContent = `${detectedLang.flag} ${detectedLang.name} (${detectedFull})`;
          }

          const syncDetectedDesc = () => {
            if (!detectedActionDesc) return;
            const isAlready =
              (detectedLang.native && detectedLang.nativeCode === currentLang && !getGoogTransTarget()) ||
              (!detectedLang.native && getGoogTransTarget() === detectedLang.code);

            if (isAlready) {
              detectedActionDesc.textContent =
                currentLang === 'zh'
                  ? '（已是目前頁面語言）'
                  : currentLang === 'en'
                    ? '(Current language)'
                    : '（現在の言語です）';
            } else {
              const prefix =
                currentLang === 'zh'
                  ? '點擊立即切換至 '
                  : currentLang === 'en'
                    ? 'Switch to '
                    : 'クリックして切り替え: ';
              detectedActionDesc.textContent = `${prefix}${detectedLang.name}`;
            }
          };

          const renderManualList = (filterText = '') => {
            if (!manualListEl) return;
            const q = filterText.trim().toLowerCase();
            const items = q
              ? WORLD_LANGS.filter(
                  (l) =>
                    l.name.toLowerCase().includes(q) ||
                    l.enName.toLowerCase().includes(q) ||
                    l.code.toLowerCase().includes(q) ||
                    (l.kw && l.kw.toLowerCase().includes(q))
                )
              : WORLD_LANGS;

            manualListEl.innerHTML = '';
            items.forEach((item) => {
              const b = document.createElement('button');
              b.type = 'button';
              const isActive = item.code === activeCode;
              b.className = isActive ? 'lang-menu-item active' : 'lang-menu-item';
              b.setAttribute('role', 'menuitem');
              b.dataset.langCode = item.code;

              const content = document.createElement('div');
              content.className = 'lang-item-content';

              const icon = document.createElement('span');
              icon.className = 'lang-item-icon';
              icon.textContent = item.flag;

              const labels = document.createElement('div');
              labels.className = 'lang-item-labels';

              const nameEl = document.createElement('span');
              nameEl.className = 'lang-item-name';
              nameEl.textContent = item.name;

              const descEl = document.createElement('small');
              descEl.className = 'lang-item-desc';
              descEl.textContent = item.enName;

              labels.appendChild(nameEl);
              labels.appendChild(descEl);
              content.appendChild(icon);
              content.appendChild(labels);
              b.appendChild(content);

              if (isActive) {
                const check = document.createElement('span');
                check.className = 'lang-item-check';
                check.setAttribute('aria-hidden', 'true');
                check.textContent = '✓';
                b.appendChild(check);
              }

              b.addEventListener('click', () => {
                applyLanguage(item.code, 'manual');
              });

              manualListEl.appendChild(b);
            });

            if (noMatchEl) {
              noMatchEl.hidden = items.length > 0;
            }
          };

          const setModeUI = (mode: 'auto' | 'manual') => {
            currentMode = mode;
            if (tabAuto) {
              tabAuto.classList.toggle('active', mode === 'auto');
              tabAuto.setAttribute('aria-selected', mode === 'auto' ? 'true' : 'false');
            }
            if (tabManual) {
              tabManual.classList.toggle('active', mode === 'manual');
              tabManual.setAttribute('aria-selected', mode === 'manual' ? 'true' : 'false');
            }
            if (panelAuto) panelAuto.hidden = mode !== 'auto';
            if (panelManual) panelManual.hidden = mode !== 'manual';
          };

          const applyLanguage = (code: string, mode: 'auto' | 'manual', useReplace = false) => {
            const targetObj = WORLD_LANGS.find((l) => l.code === code) || WORLD_LANGS[0];
            try {
              localStorage.setItem(MODE_KEY, mode);
              if (mode === 'manual') {
                localStorage.setItem(CODE_KEY, targetObj.code);
              } else {
                localStorage.removeItem(CODE_KEY);
              }
            } catch (_) {}

            if (targetObj.native) {
              const hadGt = Boolean(
                getGoogTransTarget() ||
                  document.documentElement.classList.contains('translated-ltr') ||
                  document.documentElement.classList.contains('translated-rtl')
              );
              clearGoogTransCookie();
              const targetUrl =
                targetObj.nativeCode === 'zh' ? urlZh : targetObj.nativeCode === 'en' ? urlEn : urlJa;
              closeDropdown();
              if (targetObj.nativeCode !== currentLang) {
                if (useReplace) {
                  window.location.replace(targetUrl);
                } else {
                  window.location.href = targetUrl;
                }
              } else if (hadGt) {
                window.location.reload();
              } else {
                activeCode = targetObj.code;
                renderManualList(searchInput instanceof HTMLInputElement ? searchInput.value : '');
                syncDetectedDesc();
              }
            } else {
              activeCode = targetObj.code;
              renderManualList(searchInput instanceof HTMLInputElement ? searchInput.value : '');
              syncDetectedDesc();
              closeDropdown();
              ensureGoogleTranslate(targetObj.code);
            }
          };

          // 初始化顯示狀態與清單
          setModeUI(currentMode);
          renderManualList();
          syncDetectedDesc();

          // 跨頁或首次造訪自動套用邏輯
          const gtCookie = getGoogTransTarget();
          if (currentMode === 'manual') {
            const manualObj = WORLD_LANGS.find((l) => l.code === activeCode);
            if (manualObj && !manualObj.native) {
              ensureGoogleTranslate(manualObj.code);
            } else if (gtCookie) {
              clearGoogTransCookie();
            }
          } else {
            const isRootEntry = normPath(window.location.pathname) === normPath(urlZh);
            let autoApplied = false;
            try {
              autoApplied = sessionStorage.getItem('nfu_auto_lang_applied') === '1';
            } catch (_) {}

            if (!detectedLang.native && gtCookie === detectedLang.code) {
              activeCode = detectedLang.code;
              ensureGoogleTranslate(detectedLang.code);
            } else if (isRootEntry && !autoApplied) {
              try {
                sessionStorage.setItem('nfu_auto_lang_applied', '1');
              } catch (_) {}
              if (detectedLang.code !== 'zh-TW') {
                applyLanguage(detectedLang.code, 'auto', true);
              }
            }
          }

          menu.addEventListener('click', (e) => {
            e.stopPropagation();
          });

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = dropdown.classList.toggle('open');
            btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          if (tabAuto) {
            tabAuto.addEventListener('click', () => {
              setModeUI('auto');
              applyLanguage(detectedLang.code, 'auto');
            });
          }

          if (tabManual) {
            tabManual.addEventListener('click', () => {
              setModeUI('manual');
              try {
                localStorage.setItem(MODE_KEY, 'manual');
              } catch (_) {}
              renderManualList(searchInput instanceof HTMLInputElement ? searchInput.value : '');
              if (searchInput instanceof HTMLInputElement && window.matchMedia?.('(pointer: fine)')?.matches) {
                requestAnimationFrame(() => searchInput.focus());
              }
            });
          }

          if (searchInput instanceof HTMLInputElement) {
            searchInput.addEventListener('input', () => {
              renderManualList(searchInput.value);
            });
          }

          if (switchDetectedBtn) {
            switchDetectedBtn.addEventListener('click', () => {
              applyLanguage(detectedLang.code, 'auto');
            });
          }

          document.addEventListener('click', (e) => {
            const target = e.target;
            if (target instanceof Node && !dropdown.contains(target)) {
              closeDropdown();
            }
          });
        }

        // ==========================================
        // === 智慧郵件聯絡彈窗與自動複製邏輯（支援桌機與行動裝置） ===
        // ==========================================
        const contactModal = document.getElementById('contact-email-modal');
        const contactCloseBtn = document.getElementById('contact-modal-close');
        const contactToast = document.getElementById('contact-toast');
        const copyAgainBtn = document.getElementById('btn-copy-email-again');
        const badgeCopied = document.getElementById('contact-badge-copied');
        const targetEmail = 'chenwr@nfu.edu.tw';

        const showToast = (text?: string) => {
          if (!contactToast) return;
          if (text) {
            const span = document.getElementById('contact-toast-text');
            if (span) span.textContent = text;
          }
          contactToast.classList.add('show');
          clearTimeout(win.__contactToastTimer);
          win.__contactToastTimer = setTimeout(() => {
            contactToast.classList.remove('show');
          }, 2600);
        };

        const copyEmailToClipboard = async () => {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(targetEmail);
            } else {
              const ta = document.createElement('textarea');
              ta.value = targetEmail;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.focus();
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            }
            showToast();
            if (badgeCopied) {
              badgeCopied.style.display = 'inline-flex';
            }
          } catch (_) {}
        };

        const openContactModal = () => {
          if (contactModal instanceof HTMLDialogElement) {
            if (typeof contactModal.showModal === 'function') {
              contactModal.showModal();
            } else {
              contactModal.setAttribute('open', '');
            }
            copyEmailToClipboard();
          }
        };

        const closeContactModal = () => {
          if (contactModal instanceof HTMLDialogElement) {
            if (typeof contactModal.close === 'function') {
              contactModal.close();
            } else {
              contactModal.removeAttribute('open');
            }
          }
        };

        if (contactCloseBtn) {
          contactCloseBtn.addEventListener('click', closeContactModal);
        }
        if (contactModal) {
          contactModal.addEventListener('click', (e) => {
            if (e.target === contactModal) closeContactModal();
          });
        }
        if (copyAgainBtn) {
          copyAgainBtn.addEventListener('click', () => {
            copyEmailToClipboard();
            const lbl = document.getElementById('label-copy-again');
            if (lbl) {
              const orig = lbl.textContent;
              lbl.textContent = '✓ 已成功複製！';
              setTimeout(() => {
                lbl.textContent = orig;
              }, 2000);
            }
          });
        }

        document.addEventListener('click', (e) => {
          const trigger =
            e.target instanceof Element
              ? e.target.closest('[data-contact-email-trigger], a[href^="mailto:"]')
              : null;
          if (!trigger) return;
          if (trigger.closest('#contact-email-modal')) return;
          e.preventDefault();
          openContactModal();
        });

        // ==========================================
        // === 全站通用卡片詳細資訊彈窗與無障礙鍵盤優先層級 ===
        // ==========================================
        const uModal = document.getElementById('u-card-modal');
        const uCloseBtn = document.getElementById('u-modal-close');
        const uMedia = document.getElementById('u-modal-media');
        const uImg = document.getElementById('u-modal-img');
        const uIcon = document.getElementById('u-modal-icon');
        const uBadgeRow = document.getElementById('u-modal-badge-row');
        const uTitle = document.getElementById('u-modal-title');
        const uSubtitle = document.getElementById('u-modal-subtitle');
        const uQuote = document.getElementById('u-modal-quote');
        const uDesc = document.getElementById('u-modal-desc');
        const uSections = document.getElementById('u-modal-sections');
        const uActionsWrap = document.getElementById('u-modal-actions-wrap');
        const uActions = document.getElementById('u-modal-actions');
        let lastCardTrigger: HTMLElement | null = null;

        const closeCardModal = () => {
          if (uModal instanceof HTMLDialogElement && uModal.open) {
            uModal.close();
          }
          document.body.style.overflow = '';
          if (lastCardTrigger instanceof HTMLElement) {
            lastCardTrigger.focus();
            lastCardTrigger = null;
          }
        };

        const openCardModal = (data: any, trigger: Element | null) => {
          if (!(uModal instanceof HTMLDialogElement) || typeof uModal.showModal !== 'function') return;
          lastCardTrigger = trigger instanceof HTMLElement ? trigger : null;

          if (uMedia && uImg instanceof HTMLImageElement) {
            if (data.image) {
              uImg.src = data.image;
              uImg.alt = data.title || '';
              uMedia.hidden = false;
            } else {
              uImg.src = '';
              uImg.alt = '';
              uMedia.hidden = true;
            }
          }

          if (uIcon) {
            if (data.icon) {
              uIcon.textContent = data.icon;
              uIcon.hidden = false;
            } else {
              uIcon.textContent = '';
              uIcon.hidden = true;
            }
          }

          if (uBadgeRow) {
            uBadgeRow.innerHTML = '';
            if (data.badge) {
              const span = document.createElement('span');
              span.className = 'tag';
              span.textContent = data.badge;
              uBadgeRow.appendChild(span);
            }
          }

          if (uTitle) uTitle.textContent = data.title || '';

          if (uSubtitle) {
            if (data.subtitle) {
              uSubtitle.textContent = data.subtitle;
              uSubtitle.hidden = false;
            } else {
              uSubtitle.textContent = '';
              uSubtitle.hidden = true;
            }
          }

          if (uQuote) {
            if (data.quote) {
              uQuote.textContent = data.quote;
              uQuote.hidden = false;
            } else {
              uQuote.textContent = '';
              uQuote.hidden = true;
            }
          }

          if (uDesc) {
            if (data.desc) {
              uDesc.textContent = data.desc;
              uDesc.hidden = false;
            } else {
              uDesc.textContent = '';
              uDesc.hidden = true;
            }
          }

          if (uSections) {
            uSections.innerHTML = '';
            const secs = Array.isArray(data.sections) ? data.sections : [];
            secs.forEach((sec: any) => {
              const wrap = document.createElement('div');
              wrap.className = 'u-modal-section';

              if (sec.title) {
                const h3 = document.createElement('h3');
                h3.textContent = sec.title;
                wrap.appendChild(h3);
              }

              if (Array.isArray(sec.list) && sec.list.length > 0) {
                const ul = document.createElement('ul');
                ul.className = 'u-modal-list';
                sec.list.forEach((item: string) => {
                  const li = document.createElement('li');
                  li.textContent = item;
                  ul.appendChild(li);
                });
                wrap.appendChild(ul);
              }

              if (Array.isArray(sec.tags) && sec.tags.length > 0) {
                const tagsBox = document.createElement('div');
                tagsBox.className = 'u-modal-tags';
                sec.tags.forEach((tg: string) => {
                  const s = document.createElement('span');
                  s.className = 'tag';
                  s.textContent = tg;
                  tagsBox.appendChild(s);
                });
                wrap.appendChild(tagsBox);
              }

              if (Array.isArray(sec.cards) && sec.cards.length > 0) {
                const grid = document.createElement('div');
                grid.className = 'u-modal-subcards';
                sec.cards.forEach((c: any) => {
                  const card = document.createElement('div');
                  card.className = 'u-modal-subcard';

                  const head = document.createElement('div');
                  head.className = 'u-modal-subcard-head';
                  const strong = document.createElement('strong');
                  if (c.url) {
                    const a = document.createElement('a');
                    a.href = c.url;
                    if (c.url.startsWith('http')) {
                      a.target = '_blank';
                      a.rel = 'noopener noreferrer';
                    }
                    a.textContent = `${c.title} ↗`;
                    strong.appendChild(a);
                  } else {
                    strong.textContent = c.title;
                  }
                  head.appendChild(strong);

                  if (c.badge) {
                    const b = document.createElement('span');
                    b.className = 'tag';
                    b.textContent = c.badge;
                    head.appendChild(b);
                  }
                  card.appendChild(head);

                  if (c.meta) {
                    const metaP = document.createElement('p');
                    metaP.textContent = c.meta;
                    card.appendChild(metaP);
                  }
                  if (c.desc) {
                    const descP = document.createElement('p');
                    descP.textContent = c.desc;
                    card.appendChild(descP);
                  }
                  grid.appendChild(card);
                });
                wrap.appendChild(grid);
              }

              uSections.appendChild(wrap);
            });
          }

          if (uActionsWrap && uActions) {
            uActions.innerHTML = '';
            const acts = Array.isArray(data.actions) ? data.actions : [];
            if (acts.length > 0) {
              acts.forEach((act: any) => {
                if (act.contactEmail) {
                  const b = document.createElement('button');
                  b.type = 'button';
                  b.className = act.primary ? 'u-action-pill primary' : 'u-action-pill';
                  b.textContent = act.label;
                  b.addEventListener('click', () => {
                    closeCardModal();
                    openContactModal();
                  });
                  uActions.appendChild(b);
                } else {
                  const a = document.createElement('a');
                  a.className = act.primary ? 'u-action-pill primary' : 'u-action-pill';
                  a.href = act.url;
                  if (act.external || (act.url && act.url.startsWith('http'))) {
                    a.target = '_blank';
                    a.rel = 'noopener noreferrer';
                    a.textContent = `${act.label} ↗`;
                  } else {
                    a.textContent = `${act.label} →`;
                    a.addEventListener('click', () => {
                      uModal.close();
                      document.body.style.overflow = '';
                    });
                  }
                  uActions.appendChild(a);
                }
              });
              uActionsWrap.hidden = false;
            } else {
              uActionsWrap.hidden = true;
            }
          }

          const box = uModal.querySelector('.u-modal-box');
          if (box) box.scrollTop = 0;
          uModal.showModal();
          document.body.style.overflow = 'hidden';
        };

        const defaultOpenLabel =
          currentLang === 'zh'
            ? '前往相關網頁／官方公告'
            : currentLang === 'en'
              ? 'Open Official Page / Link'
              : '公式ページ・関連リンクを開く';

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const trigger = target.closest('[data-card-modal]');
          if (!trigger) return;
          const innerSkip = target.closest(
            'a[data-no-modal], button[data-no-modal], iframe, input, select, [data-contact-email-trigger]'
          );
          if (innerSkip && trigger.contains(innerSkip) && innerSkip !== trigger) return;
          const innerLink = target.closest('a');
          if (innerLink && trigger.contains(innerLink) && innerLink !== trigger) return;

          const raw = trigger.getAttribute('data-card-modal');
          if (!raw) return;
          if (trigger.tagName === 'A') e.preventDefault();
          try {
            const data = JSON.parse(raw);
            if ((!Array.isArray(data.actions) || data.actions.length === 0) && trigger.tagName === 'A') {
              const href = trigger.getAttribute('href');
              if (href) {
                data.actions = [
                  { label: defaultOpenLabel, url: href, primary: true, external: href.startsWith('http') },
                ];
              }
            }
            openCardModal(data, trigger);
          } catch (_) {}
        });

        if (uCloseBtn) {
          uCloseBtn.addEventListener('click', closeCardModal);
        }
        if (uModal instanceof HTMLDialogElement) {
          uModal.addEventListener('click', (e) => {
            if (e.target === uModal) closeCardModal();
          });
          uModal.addEventListener('close', () => {
            document.body.style.overflow = '';
            if (lastCardTrigger instanceof HTMLElement) {
              lastCardTrigger.focus();
              lastCardTrigger = null;
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (uModal instanceof HTMLDialogElement && uModal.open) {
              e.preventDefault();
              e.stopPropagation();
              closeCardModal();
              return;
            }
            if (dropdown?.classList.contains('open')) {
              e.preventDefault();
              e.stopPropagation();
              closeDropdown();
              btn?.focus();
              return;
            }
            if (siteNav?.classList.contains('open')) {
              e.preventDefault();
              closeNav();
              navBtn?.focus();
              return;
            }
          }
          if ((e.key === 'Enter' || e.key === ' ') && e.target instanceof Element) {
            const trigger = e.target.closest('[data-card-modal]');
            if (trigger && trigger === e.target && trigger.tagName !== 'A' && trigger.tagName !== 'BUTTON') {
              e.preventDefault();
              if (trigger instanceof HTMLElement) trigger.click();
            }
          }
        });

        // ==========================================
        // === 站內連結懸停／觸控預載（Instant Navigation Prefetch） ===
        // ==========================================
        const prefetched = new Set<string>();
        const prefetchHref = (href: string) => {
          if (!href || prefetched.has(href) || !href.startsWith('/') || href.includes('#')) return;
          prefetched.add(href);
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = href;
          document.head.appendChild(link);
        };
        const handlePrefetch = (e: Event) => {
          const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!a || a.hasAttribute('data-card-modal')) return;
          prefetchHref(a.getAttribute('href') || '');
        };
        document.addEventListener('pointerover', handlePrefetch, { passive: true });
        document.addEventListener('touchstart', handlePrefetch, { passive: true });

        // ==========================================
        // === 分頁圖示動畫（Tab Favicon Animation） ===
        // ==========================================
        (() => {
          try {
            const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
            if (prefersReduced) return;

            const favEl = document.getElementById('dynamic-favicon');
            if (!(favEl instanceof HTMLLinkElement)) return;

            const totalFrames = 8;
            let frameIdx = 0;
            let frameTimer: ReturnType<typeof setInterval> | null = null;

            const frameImgs = Array.from({ length: totalFrames }, (_, f) => {
              const img = new Image();
              img.src = `${tabFramePrefix}${f}.png`;
              return img;
            });

            const cycle = () => {
              if (document.hidden) return;
              frameIdx = (frameIdx + 1) % totalFrames;
              favEl.href = frameImgs[frameIdx].src;
            };

            frameTimer = setInterval(cycle, 180);

            document.addEventListener('visibilitychange', () => {
              if (document.hidden) {
                if (frameTimer) {
                  clearInterval(frameTimer);
                  frameTimer = null;
                }
              } else if (!frameTimer) {
                frameTimer = setInterval(cycle, 180);
              }
            });
          } catch (_) {}
        })();

        // ==========================================
        // === 科技感滑鼠互動體驗（Mouse Interactivity） ===
        // ==========================================
        const hasPointerFine = window.matchMedia?.('(pointer: fine)')?.matches;
        const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
        if (!hasPointerFine || prefersReducedMotion) return;

        // 1. 全域滑鼠聚光燈（支援靜止時暫停 requestAnimationFrame）
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight * 0.35;
        let targetX = mouseX;
        let targetY = mouseY;
        let isSpotlightRunning = false;

        const updateSpotlight = () => {
          const dx = targetX - mouseX;
          const dy = targetY - mouseY;
          if (Math.abs(dx) > 0.15 || Math.abs(dy) > 0.15) {
            mouseX += dx * 0.15;
            mouseY += dy * 0.15;
            document.documentElement.style.setProperty('--mouse-x', `${mouseX.toFixed(1)}px`);
            document.documentElement.style.setProperty('--mouse-y', `${mouseY.toFixed(1)}px`);
            requestAnimationFrame(updateSpotlight);
          } else {
            mouseX = targetX;
            mouseY = targetY;
            document.documentElement.style.setProperty('--mouse-x', `${mouseX.toFixed(1)}px`);
            document.documentElement.style.setProperty('--mouse-y', `${mouseY.toFixed(1)}px`);
            isSpotlightRunning = false;
          }
        };

        window.addEventListener(
          'mousemove',
          (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!isSpotlightRunning) {
              isSpotlightRunning = true;
              requestAnimationFrame(updateSpotlight);
            }
          },
          { passive: true }
        );

        // 2. 卡片 3D 視差傾斜與邊界流光（Card 3D Tilt & Magnetic Border Glow）
        const bindCards = () => {
          const cards = document.querySelectorAll('.card, .stat, .hero-logo-box, .advisor');
          cards.forEach((card) => {
            if (!(card instanceof HTMLElement) || card.dataset.hasTilt) return;
            card.dataset.hasTilt = '1';

            card.addEventListener(
              'mousemove',
              (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--card-x', `${x.toFixed(1)}px`);
                card.style.setProperty('--card-y', `${y.toFixed(1)}px`);

                const cx = rect.width / 2;
                const cy = rect.height / 2;
                const rotX = ((y - cy) / cy) * -6;
                const rotY = ((x - cx) / cx) * 6;
                card.style.transform = `perspective(900px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateY(-4px)`;
              },
              { passive: true }
            );

            card.addEventListener('mouseleave', () => {
              card.style.transform = '';
              card.style.removeProperty('--card-x');
              card.style.removeProperty('--card-y');
            });
          });
        };
        bindCards();
        window.addEventListener('load', bindCards);

        // 3. 首頁 Hero 主視覺 Logo 滑鼠 3D 視差
        const hero = document.querySelector('.hero');
        const logoBox = document.querySelector('.hero-logo-box');
        const halo = document.querySelector('.hero-logo-halo');
        if (hero && logoBox instanceof HTMLElement) {
          hero.addEventListener(
            'mousemove',
            (e) => {
              const rect = hero.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              const rotX = -(y / rect.height) * 12;
              const rotY = (x / rect.width) * 12;
              logoBox.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateZ(12px)`;
              if (halo instanceof HTMLElement) {
                halo.style.transform = `translate(${(-x * 0.04).toFixed(1)}px, ${(-y * 0.04).toFixed(1)}px)`;
              }
            },
            { passive: true }
          );

          hero.addEventListener('mouseleave', () => {
            logoBox.style.transform = '';
            if (halo instanceof HTMLElement) halo.style.transform = '';
          });
        }

        // 4. 按鈕微磁吸回饋（Magnetic Button Attraction）
        const btns = document.querySelectorAll('.btn, .theme-btn, .lang-btn');
        btns.forEach((b) => {
          if (!(b instanceof HTMLElement)) return;
          b.addEventListener(
            'mousemove',
            (e) => {
              const rect = b.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              b.style.transform = `translate(${(x * 0.2).toFixed(1)}px, ${(y * 0.2).toFixed(1)}px)`;
            },
            { passive: true }
          );
          b.addEventListener('mouseleave', () => {
            b.style.transform = '';
          });
        });
      })();
    </script>
  </body>
</html>
